        </section>
    </main>

    <!-- Bottom Prev / Next Navigation -->
    <div class="bottom-controls">
        <button class="nav-arrow" onclick="changePage(-1)"><i class="fa-solid fa-arrow-left"></i> ቀዳሚ ገጽ</button>
        <span style="color: var(--gold-bright); font-weight: 600; font-size: 0.9rem;" id="bottom-title">መግቢያ</span>
        <button class="nav-arrow" onclick="changePage(1)">ቀጣይ ገጽ <i class="fa-solid fa-arrow-right"></i></button>
    </div>

    <script>
        const totalPages = 22;
        let currentPage = 1;

        const pageTitles = [
            "መግቢያ", "ስለኛ", "የሪል እስቴት መስታወት", "የአፓርትመንቶች መስታወት",
            "የሻወር ቦክስ", "ፍሬምለስ ፓርትሽን", "ሀንዲሪል", "ከለር ያላቸው መስታወቶች",
            "ሻወር ቦክስ ጋለሪ ፩", "ሻወር ቦክስ ጋለሪ ፪", "ሀንዲሪል ጋለሪ ፩", "ሀንዲሪል ጋለሪ ፪",
            "ፍሬምለስ ፓርትሽን ጋለሪ", "ሪል እስቴት ጋለሪ", "ልዩ ዲዛይን ጋለሪ", "የመስታወት ውፍረቶች",
            "ቴምፐርድ መስታወት", "የአሠራር ሂደት", "አክሰሰሪዎች", "የንግድ አጋርነት",
            "ተደጋጋሚ ጥያቄዎች", "ማነጋገሪያ"
        ];

        // Generate 1 to 22 buttons in the top strip
        const strip = document.getElementById('page-strip');
        for (let i = 1; i <= totalPages; i++) {
            const btn = document.createElement('button');
            btn.className = 'page-num-btn' + (i === 1 ? ' active' : '');
            btn.textContent = i;
            btn.id = 'btn-page-' + i;
            btn.title = `ገጽ ${i}: ${pageTitles[i - 1]}`;
            btn.onclick = () => goToPage(i);
            strip.appendChild(btn);
        }

        function goToPage(pageNum) {
            if (pageNum < 1) pageNum = totalPages;
            if (pageNum > totalPages) pageNum = 1;
            currentPage = pageNum;

            // Hide all pages and deactivate buttons
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.page-num-btn').forEach(b => b.classList.remove('active'));

            // Show target page
            const targetPage = document.getElementById('page-' + currentPage);
            targetPage.classList.add('active');

            // Apply unique background color of that specific page to body & section
            const bg = targetPage.getAttribute('data-bg');
            document.body.style.background = bg;
            targetPage.style.background = bg;

            // Highlight active page button
            const activeBtn = document.getElementById('btn-page-' + currentPage);
            activeBtn.classList.add('active');
            activeBtn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });

            // Update counters and titles
            document.getElementById('page-counter').textContent = `ገጽ ${currentPage} / ${totalPages}`;
            document.getElementById('bottom-title').textContent = `${currentPage}. ${pageTitles[currentPage - 1]}`;

            // Highlight main menu buttons
            document.querySelectorAll('.main-nav button').forEach(b => b.classList.remove('active-nav'));
            if (currentPage === 1) document.getElementById('nav-home').classList.add('active-nav');
            else if (currentPage === 2) document.getElementById('nav-about').classList.add('active-nav');
            else if (currentPage >= 3 && currentPage <= 8) document.getElementById('nav-services').classList.add('active-nav');
            else if (currentPage === 22) document.getElementById('nav-contact').classList.add('active-nav');

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function changePage(step) {
            goToPage(currentPage + step);
        }

        // Initialize Page 1 background
        goToPage(1);
    </script>
</body>
</html>
